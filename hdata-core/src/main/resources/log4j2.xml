<?xml version="1.0" encoding="UTF-8"?>
<!--
  HData is an executable program, so this file provides a usable default logging configuration.
  Override it with -Dlog4j2.configurationFile=/path/to/log4j2.xml when customization is needed.
-->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %c{1.} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="me.jayer.hdata" level="INFO"/>
        <Logger name="org.apache.beam" level="WARN"/>
        <Root level="WARN">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
