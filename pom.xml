                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>me.jayer</groupId>
                <artifactId>hdata-elasticsearch-8</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>me.jayer</groupId>
