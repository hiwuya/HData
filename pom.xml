            <!-- Client dependencies for optional connectors. -->
            <dependency>
                <groupId>org.apache.kafka</groupId>
                <artifactId>kafka-clients</artifactId>
                <version>4.3.1</version>
            </dependency>
            <dependency>
                <groupId>org.redisson</groupId>
