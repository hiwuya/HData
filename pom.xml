    <inceptionYear>2022</inceptionYear>
    <licenses>
        <license>
            <name>Apache License 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:git://github.com/stuxuhai/HData.git</connection>
        <url>https://github.com/stuxuhai/HData</url>
        <tag>HEAD</tag>
    </scm>

    <developers>
        <developer>
            <name>Jayer</name>
            <email>dczxxuhai@gmail.com</email>
            <url>https://github.com/stuxuhai</url>
        </developer>
    </developers>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <kotlin.version>2.4.20</kotlin.version>
        <beam.version>2.76.0</beam.version>
        <jackson.version>3.2.1</jackson.version>
        <jackson-annotations.version>2.22</jackson-annotations.version>
        <slf4j.version>2.0.18</slf4j.version>
        <log4j.version>2.26.1</log4j.version>
        <junit.version>5.14.0</junit.version>
        <h2.version>2.4.240</h2.version>
        <kafka.version>4.3.1</kafka.version>
        <redisson.version>3.40.0</redisson.version>
        <embedded.redis.version>1.4.3</embedded.redis.version>
        <neo4j.driver.version>5.27.0</neo4j.driver.version>
        <iceberg.version>1.10.0</iceberg.version>
        <debezium.version>3.0.4.Final</debezium.version>
        <connect.runtime.version>3.9.1</connect.runtime.version>
        <pulsar.version>4.0.13</pulsar.version>
        <ftpserver.version>1.2.1</ftpserver.version>
        <!-- Keep this aligned with the Spark version declared by beam-runners-spark-4:${beam.version}. -->
        <spark.version>4.0.2</spark.version>
        <!--
            Keep Hadoop at 3.5.0. Spark 4.0.2 bundles Hadoop 3.4.1, whose
            UserGroupInformation implementation uses the legacy Subject.getSubject API.
            Hadoop 3.5.0 uses Subject.current() instead.
        -->
        <hadoop.version>3.5.0</hadoop.version>
        <!--
            The Hive connector uses only the metastore Thrift client and data-file format libraries;
            it does not depend on hive-jdbc or hive-exec. Use ORC's shaded-protobuf artifacts to
            isolate ORC's protobuf dependency from the versions brought in by Hadoop and Beam.
        -->
        <hive.version>4.0.1</hive.version>
        <orc.version>2.3.0</orc.version>
        <parquet.version>1.17.1</parquet.version>
        <avro.version>1.12.1</avro.version>
        <thrift.version>0.16.0</thrift.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <rabbitmq.version>5.24.0</rabbitmq.version>
        <clickhouse.version>0.9.8</clickhouse.version>
        <cassandra.driver.version>4.17.0</cassandra.driver.version>
        <aws.sdk.version>2.25.16</aws.sdk.version>
        <prometheus.client.version>0.16.0</prometheus.client.version>
        <dynamodb.local.version>2024-06-13</dynamodb.local.version>
    </properties>

    <modules>
        <module>hdata-core</module>
        <module>hdata-jdbc</module>
        <module>hdata-kafka</module>
        <module>hdata-pulsar</module>
        <module>hdata-hive</module>
        <module>hdata-mongodb</module>
        <module>hdata-hbase</module>
        <module>hdata-ftp</module>
        <module>hdata-filesystem</module>
        <module>hdata-elasticsearch-6</module>
        <module>hdata-elasticsearch-8</module>
        <module>hdata-redis</module>
        <module>hdata-neo4j</module>
        <module>hdata-iceberg</module>
        <module>hdata-debezium</module>
        <module>hdata-rabbitmq</module>
        <module>hdata-clickhouse</module>
        <module>hdata-cassandra</module>
        <module>hdata-sqs</module>
        <module>hdata-prometheus</module>
        <module>hdata-dynamodb</module>
    </modules>

